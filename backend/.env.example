# ==============================================================================
# BIN ESSA ERP — BACKEND PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================

# 1. Primary PostgreSQL Connection String (Direct for Migrations & Local Dev)
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?schema=public"

# 2. PgBouncer High-Concurrency Pooled Connection String (Port 6432)
POOLED_DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<PGBOUNCER_HOST>:6432/<DB_NAME>?schema=public&pgbouncer=true"

# 3. Server Environment & JWT Security
PORT=4000
NODE_ENV=production
JWT_SECRET="<GENERATE_SECURE_RANDOM_64_CHAR_HEX_KEY>"

# 4. Redis Cache Layer
REDIS_HOST="redis"
REDIS_PORT=6379

