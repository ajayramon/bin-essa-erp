// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  moduleFormat = "cjs"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ================= ENUMS (24) =================

enum BrandId {
  BIN_ESSA_SMOKING_CENTER
  BIN_ESSA_KHIRAN
  JM_ART_ZONE
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
  ACCOUNTANT
  STOREKEEPER
  SALES_REP
  B2B_CUSTOMER
}

enum ItemCategory {
  TOBACCO
  ACCESSORIES
  ELECTRONICS
  ART_SUPPLIES
  OTHER
}

enum ItemVisibility {
  ALL_BRANCHES
  SPECIFIC_BRANCHES
}

enum PaymentMethod {
  CASH
  CARD
  KNET
  HESABI
  TABBY
  CREDIT
  BANK_TRANSFER
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum InvoiceStatus {
  DRAFT
  POSTED
  PAID
  VOID
}

enum JournalEntryStatus {
  DRAFT
  POSTED
}

enum PurchaseOrderStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum StockMovementType {
  SALE
  PURCHASE
  ADJUSTMENT
}

enum PromotionDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromotionTargetType {
  PRODUCT
  PRODUCT_GROUP
  CATEGORY
  ALL_PRODUCTS
}

enum PromotionBranchScope {
  ALL_BRANCHES
  SPECIFIC_BRANCHES
}

enum PromotionCustomerScope {
  ALL_CUSTOMERS
  SPECIFIC_CUSTOMER
  CUSTOMER_GROUP
}

enum DiscountType {
  MANUAL_LINE
  MANUAL_HEADER
  PROMOTION
}

enum TransferStatus {
  DRAFT
  DISPATCHED
  RECEIVED
  CANCELLED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum OrderStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  CREDIT_HOLD
  INVOICED
  CANCELLED
}

enum PdcStatus {
  RECEIVED
  DEPOSITED
  CLEARED
  BOUNCED
}

enum SerialStatus {
  IN_STOCK
  SOLD
  RETURNED
}

enum MovementType {
  SALE
  PURCHASE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN
}

enum AdjustmentReason {
  DAMAGE
  SHRINKAGE
  EXPIRY
  COUNT_CORRECTION
  OTHER
}

enum AdjustmentStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum StockCountStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BankTxType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  CHARGE
  INTEREST
}

enum ReconStatus {
  DRAFT
  RECONCILED
}

enum CostCenterType {
  BRANCH
  WAREHOUSE
  DEPARTMENT
  CUSTOM
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum LoyaltyTxType {
  EARN
  REDEEM
  EXPIRE
  RETURN_REVERSAL
  MANUAL_ADJUSTMENT
}

enum TargetPeriod {
  WEEKLY
  MONTHLY
  ANNUAL
}

enum LeaveType {
  ANNUAL
  SICK
  EMERGENCY
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PrStatus {
  PENDING
  APPROVED
  REJECTED
  ORDERED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  CONVERTED
}

// ================= CORE ENTERPRISE MODELS =================

model Branch {
  id       String  @id @default(uuid())
  code     String  @unique // e.g. "br-01"
  name     String
  brandId  BrandId
  nameEn   String?
  nameAr   String?
  city     String?
  address  String?
  isActive Boolean @default(true)

  users                 User[]
  itemStocks            ItemStock[]
  customers             Customer[]
  suppliers             Supplier[]
  salesInvoices         SalesInvoice[]
  journalEntries        JournalEntry[]
  purchaseOrders        PurchaseOrder[]
  purchaseInvoices      PurchaseInvoice[]
  salesOrders           SalesOrder[]
  posShifts             PosShift[]
  promotionBranches     PromotionBranch[]
  stockAdjustments      StockAdjustment[]
  stockCounts           StockCount[]
  cashAccounts          CashAccount[]
  expenses              Expense[]
  receiptVouchers       ReceiptVoucher[]
  paymentVouchers       PaymentVoucher[]
  purchaseRequisitions  PurchaseRequisition[]
  goodsReceiptNotes     GoodsReceiptNote[]
  quotations            Quotation[]
  deliveryNotes         DeliveryNote[]
  employees             Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String  @id @default(uuid())
  username     String  @unique
  passwordHash String
  fullName     String
  role         Role
  branchId     String?
  branch       Branch? @relation(fields: [branchId], references: [id])
  isActive     Boolean @default(true)

  salesInvoices      SalesInvoice[]
  posShifts          PosShift[]
  discountPermission UserDiscountPermission?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Item {
  id                 String         @id @default(uuid())
  sku                String         @unique
  barcode            String?        @unique
  name               String
  nameEn             String?
  nameAr             String?
  category           ItemCategory
  subCategory        String?
  brand              String?
  countryOfOrigin    String?
  imageUrl           String?
  visibility         ItemVisibility @default(ALL_BRANCHES)
  price              Decimal        @db.Decimal(10, 3) // Base KWD Retail Price
  cost               Decimal        @db.Decimal(10, 3)
  unit               String         @default("pcs")
  isActive           Boolean        @default(true)
  allowSale          Boolean        @default(true)
  allowPurchase      Boolean        @default(true)
  allowDiscount      Boolean        @default(true)
  allowGift          Boolean        @default(true)
  expiryRequired     Boolean        @default(false)
  posVisibility      Boolean        @default(true)
  stockQuantity      Int            @default(0)

  // Multi-Tier Selling Prices
  retailPrice        Decimal? @db.Decimal(10, 3)
  semiWholesalePrice Decimal? @db.Decimal(10, 3)
  wholesalePrice     Decimal? @db.Decimal(10, 3)

  // Admin Operational Governance Controls
  trackExpiry        Boolean @default(false)
  blockFreeGift      Boolean @default(false)
  blockDiscount      Boolean @default(false)
  maxDiscountPercent Decimal @default(100.00) @db.Decimal(5, 2)

  stocks                   ItemStock[]
  salesInvoiceLines        SalesInvoiceLine[]
  purchaseOrderLines       PurchaseOrderLine[]
  purchaseInvoiceLines     PurchaseInvoiceLine[]
  stockTransferLines       StockTransferLine[]
  salesOrderLines          SalesOrderLine[]
  promotionItems           PromotionItem[]
  variants                 ItemVariant[]
  serials                  ItemSerial[]
  batches                  ItemBatch[]
  uoms                     ItemUom[]
  additionalBarcodes       ItemBarcode[]
  stockAdjustmentLines     StockAdjustmentLine[]
  stockCountLines          StockCountLine[]
  purchaseRequisitionLines PurchaseRequisitionLine[]
  goodsReceiptLines        GoodsReceiptLine[]
  quotationLines           QuotationLine[]
  deliveryNoteLines        DeliveryNoteLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ItemBarcode {
  id        String   @id @default(uuid())
  itemId    String
  barcode   String   @unique
  note      String?
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model ItemUom {
  id              String   @id @default(uuid())
  itemId          String
  unitName        String   // "Piece", "Pack", "Box", "Carton", "KG", "Gram", "Set", "Bundle", "Package"
  conversionRatio Decimal  @db.Decimal(10, 3)
  barcode         String?  @unique
  retailPrice     Decimal? @db.Decimal(10, 3)
  wholesalePrice  Decimal? @db.Decimal(10, 3)
  isBase          Boolean  @default(false)
  item            Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ItemStock {
  id       String  @id @default(uuid())
  itemId   String
  branchId String
  quantity Decimal @default(0) @db.Decimal(10, 3)

  item   Item   @relation(fields: [itemId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([itemId, branchId])
}

model Customer {
  id            String   @id @default(uuid())
  code          String   @unique // e.g. "cust-0001"
  name          String
  phone         String?
  email         String?
  address       String?
  branchId      String?
  customerGroup String?  @default("STANDARD") // STANDARD, WHOLESALE, VIP
  creditLimit   Decimal  @default(0) @db.Decimal(10, 3)
  paymentTerms  String?  @default("NET_30")
  branch        Branch?  @relation(fields: [branchId], references: [id])

  salesInvoices      SalesInvoice[]
  salesOrders        SalesOrder[]
  payments           CustomerPayment[]
  pdcChecks          PdcCheck[]
  promotionCustomers PromotionCustomer[]
  quotations         Quotation[]
  deliveryNotes      DeliveryNote[]
  receiptVouchers    ReceiptVoucher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id           String  @id @default(uuid())
  code         String  @unique
  name         String
  phone        String?
  email        String?
  address      String?
  branchId     String?
  paymentTerms String? @default("NET_30")
  branch       Branch? @relation(fields: [branchId], references: [id])

  purchaseOrders    PurchaseOrder[]
  purchaseInvoices  PurchaseInvoice[]
  goodsReceiptNotes GoodsReceiptNote[]
  paymentVouchers   PaymentVoucher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id              String      @id @default(uuid())
  code            String      @unique // e.g. "1000" for Cash
  name            String
  type            AccountType
  parentAccountId String?
  isHeader        Boolean     @default(false)
  isActive        Boolean     @default(true)

  journalEntryLines JournalEntryLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JournalEntry {
  id          String             @id @default(uuid())
  reference   String             @unique // e.g. "JE-0001"
  date        DateTime           @default(now())
  description String?
  status      JournalEntryStatus @default(POSTED)
  branchId    String?
  branch      Branch?            @relation(fields: [branchId], references: [id])

  // Links back to auto-generated entries
  salesInvoiceId    String?          @unique
  salesInvoice      SalesInvoice?    @relation(fields: [salesInvoiceId], references: [id])

  purchaseOrderId   String?          @unique
  purchaseOrder     PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])

  purchaseInvoiceId String?          @unique
  purchaseInvoice   PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])

  customerPaymentId String?          @unique
  customerPayment   CustomerPayment? @relation(fields: [customerPaymentId], references: [id])

  stockAdjustmentId String?          @unique
  stockAdjustment   StockAdjustment? @relation(fields: [stockAdjustmentId], references: [id])

  expenseId         String?          @unique
  expense           Expense?         @relation(fields: [expenseId], references: [id])

  cashTransferId    String?          @unique
  cashTransfer      CashTransfer?    @relation(fields: [cashTransferId], references: [id])

  receiptVoucherId  String?          @unique
  receiptVoucher    ReceiptVoucher?  @relation(fields: [receiptVoucherId], references: [id])

  paymentVoucherId  String?          @unique
  paymentVoucher    PaymentVoucher?  @relation(fields: [paymentVoucherId], references: [id])

  payrollPeriodId   String?          @unique
  payrollPeriod     PayrollPeriod?   @relation(fields: [payrollPeriodId], references: [id])

  lines JournalEntryLine[]

  createdAt DateTime @default(now())
}

model JournalEntryLine {
  id             String  @id @default(uuid())
  journalEntryId String
  accountId      String
  debit          Decimal @default(0) @db.Decimal(10, 3)
  credit         Decimal @default(0) @db.Decimal(10, 3)

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])
  account      Account      @relation(fields: [accountId], references: [id])
}

model SalesInvoice {
  id                   String        @id @default(uuid())
  invoiceNumber        String        @unique // e.g. "INV-0001"
  date                 DateTime      @default(now())
  customerId           String?
  customer             Customer?     @relation(fields: [customerId], references: [id])
  branchId             String
  branch               Branch        @relation(fields: [branchId], references: [id])
  userId               String
  user                 User          @relation(fields: [userId], references: [id])
  paymentMethod        PaymentMethod
  status               InvoiceStatus @default(POSTED)
  subtotal             Decimal       @db.Decimal(10, 3)
  taxAmount            Decimal       @default(0) @db.Decimal(10, 3)
  discountAmount       Decimal       @default(0) @db.Decimal(10, 3)
  totalAmount          Decimal       @db.Decimal(10, 3)
  manualDiscountReason String?
  promotionId          String?
  posShiftId           String?
  isReturn             Boolean       @default(false)

  posShift     PosShift?          @relation(fields: [posShiftId], references: [id])
  lines        SalesInvoiceLine[]
  journalEntry JournalEntry?

  createdAt DateTime @default(now())
}

model SalesInvoiceLine {
  id                String  @id @default(uuid())
  salesInvoiceId    String
  itemId            String
  quantity          Decimal @db.Decimal(10, 3)
  unitPrice         Decimal @db.Decimal(10, 3)
  originalUnitPrice Decimal? @db.Decimal(10, 3)
  discountAmount    Decimal @default(0) @db.Decimal(10, 3)
  lineTotal         Decimal @db.Decimal(10, 3)
  promotionId       String?

  salesInvoice SalesInvoice @relation(fields: [salesInvoiceId], references: [id])
  item         Item         @relation(fields: [itemId], references: [id])
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  poNumber    String              @unique // e.g. "PO-0001"
  date        DateTime            @default(now())
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  branchId    String
  branch      Branch              @relation(fields: [branchId], references: [id])
  status      PurchaseOrderStatus @default(POSTED)
  subtotal    Decimal             @db.Decimal(10, 3)
  taxAmount   Decimal             @default(0) @db.Decimal(10, 3)
  totalAmount Decimal             @db.Decimal(10, 3)

  lines        PurchaseOrderLine[]
  journalEntry JournalEntry?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseOrderLine {
  id              String        @id @default(uuid())
  purchaseOrderId String
  itemId          String
  quantity        Decimal       @db.Decimal(10, 3)
  unitCost        Decimal       @db.Decimal(10, 3)
  lineTotal       Decimal       @db.Decimal(10, 3)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id])
}

model PurchaseInvoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique // e.g. "PINV-0001" or vendor bill #
  date          DateTime      @default(now())
  dueDate       DateTime?
  paymentTerms  String?       @default("IMMEDIATE")
  supplierId    String
  supplier      Supplier      @relation(fields: [supplierId], references: [id])
  branchId      String
  branch        Branch        @relation(fields: [branchId], references: [id])
  status        InvoiceStatus @default(POSTED)
  subtotal      Decimal       @db.Decimal(10, 3)
  taxAmount     Decimal       @default(0) @db.Decimal(10, 3)
  totalAmount   Decimal       @db.Decimal(10, 3)

  lines        PurchaseInvoiceLine[]
  journalEntry JournalEntry?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseInvoiceLine {
  id                String  @id @default(uuid())
  purchaseInvoiceId String
  itemId            String
  quantity          Decimal @db.Decimal(10, 3)
  unitCost          Decimal @db.Decimal(10, 3)
  lineTotal         Decimal @db.Decimal(10, 3)

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  item            Item            @relation(fields: [itemId], references: [id])
}

model StockTransfer {
  id             String         @id @default(uuid())
  transferNumber String         @unique // e.g. "TR-0001"
  fromBranchId   String
  toBranchId     String
  status         TransferStatus @default(DRAFT)
  notes          String?
  dispatchedAt   DateTime?
  receivedAt     DateTime?

  lines StockTransferLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockTransferLine {
  id                 String  @id @default(uuid())
  stockTransferId    String
  itemId             String
  quantityRequested  Decimal @db.Decimal(10, 3)
  quantityDispatched Decimal @default(0) @db.Decimal(10, 3)
  quantityReceived   Decimal @default(0) @db.Decimal(10, 3)

  stockTransfer StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id])
}

model PosShift {
  id                  String      @id @default(uuid())
  shiftNumber         String      @unique // e.g. "SHIFT-0001"
  userId              String
  branchId            String
  openingFloat        Decimal     @default(0) @db.Decimal(10, 3)
  cashSalesTotal      Decimal     @default(0) @db.Decimal(10, 3)
  knetSalesTotal      Decimal     @default(0) @db.Decimal(10, 3)
  hesabiSalesTotal    Decimal     @default(0) @db.Decimal(10, 3)
  tabbySalesTotal     Decimal     @default(0) @db.Decimal(10, 3)
  cardSalesTotal      Decimal     @default(0) @db.Decimal(10, 3)
  creditSalesTotal    Decimal     @default(0) @db.Decimal(10, 3)
  otherSalesTotal     Decimal     @default(0) @db.Decimal(10, 3)
  totalSales          Decimal     @default(0) @db.Decimal(10, 3)
  returnsTotal        Decimal     @default(0) @db.Decimal(10, 3)
  discountsTotal      Decimal     @default(0) @db.Decimal(10, 3)
  giftsTotal          Decimal     @default(0) @db.Decimal(10, 3)
  giftsCount          Int         @default(0)
  closingCashExpected Decimal     @default(0) @db.Decimal(10, 3)
  closingCashActual   Decimal     @default(0) @db.Decimal(10, 3)
  cashVariance        Decimal     @default(0) @db.Decimal(10, 3)
  status              ShiftStatus @default(OPEN)
  notes               String?
  openedAt            DateTime    @default(now())
  closedAt            DateTime?
  reopenedAt          DateTime?
  reopenedByUserId    String?
  adjustedAt          DateTime?
  adjustedByUserId    String?
  adjustmentReason    String?

  user          User           @relation(fields: [userId], references: [id])
  branch        Branch         @relation(fields: [branchId], references: [id])
  salesInvoices SalesInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  entity      String
  entityId    String?
  details     String?
  ipAddress   String?
  createdAt   DateTime @default(now())
}

model SalesOrder {
  id          String      @id @default(uuid())
  orderNumber String      @unique // e.g. "SO-0001"
  date        DateTime    @default(now())
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  branchId    String
  branch      Branch      @relation(fields: [branchId], references: [id])
  status      OrderStatus @default(DRAFT)
  subtotal    Decimal     @db.Decimal(10, 3)
  taxAmount   Decimal     @default(0) @db.Decimal(10, 3)
  totalAmount Decimal     @db.Decimal(10, 3)
  notes       String?

  lines SalesOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SalesOrderLine {
  id           String     @id @default(uuid())
  salesOrderId String
  itemId       String
  quantity     Decimal    @db.Decimal(10, 3)
  unitPrice    Decimal    @db.Decimal(10, 3)
  lineTotal    Decimal    @db.Decimal(10, 3)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  item       Item       @relation(fields: [itemId], references: [id])
}

model CustomerPayment {
  id            String        @id @default(uuid())
  receiptNumber String        @unique // e.g. "RCT-0001"
  date          DateTime      @default(now())
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  amount        Decimal       @db.Decimal(10, 3)
  paymentMethod PaymentMethod
  reference     String?
  notes         String?

  journalEntry JournalEntry?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PdcCheck {
  id          String    @id @default(uuid())
  checkNumber String    @unique
  bankName    String
  dueDate     DateTime
  amount      Decimal   @db.Decimal(10, 3)
  status      PdcStatus @default(RECEIVED)
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  notes       String?
  depositedAt DateTime?
  clearedAt   DateTime?
  bouncedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserDiscountPermission {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  maxDiscountPercent      Decimal  @default(10.000) @db.Decimal(10, 3)
  canEditPrices           Boolean  @default(false)
  requiresManagerApproval Boolean  @default(true)
  allowedBranchIds        String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Promotion {
  id            String                 @id @default(uuid())
  code          String                 @unique
  nameEn        String
  nameAr        String?
  description   String?
  discountType  PromotionDiscountType
  discountValue Decimal                @db.Decimal(10, 3)
  startDate     DateTime
  endDate       DateTime
  startTime     String?
  endTime       String?
  maxQuantity   Int?
  isCombinable  Boolean                @default(false)
  isActive      Boolean                @default(true)
  targetType    PromotionTargetType    @default(ALL_PRODUCTS)
  branchScope   PromotionBranchScope   @default(ALL_BRANCHES)
  customerScope PromotionCustomerScope @default(ALL_CUSTOMERS)
  customerGroup String?

  items     PromotionItem[]
  branches  PromotionBranch[]
  customers PromotionCustomer[]
  auditLogs DiscountAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromotionItem {
  id          String    @id @default(uuid())
  promotionId String
  itemId      String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([promotionId, itemId])
}

model PromotionBranch {
  id          String    @id @default(uuid())
  promotionId String
  branchId    String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([promotionId, branchId])
}

model PromotionCustomer {
  id          String    @id @default(uuid())
  promotionId String
  customerId  String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([promotionId, customerId])
}

model DiscountAuditLog {
  id               String       @id @default(uuid())
  userId           String
  userName         String
  userRole         String
  branchId         String
  invoiceNumber    String
  discountType     DiscountType
  promotionId      String?
  promotion        Promotion?   @relation(fields: [promotionId], references: [id])
  originalAmount   Decimal      @db.Decimal(10, 3)
  discountAmount   Decimal      @db.Decimal(10, 3)
  finalAmount      Decimal      @db.Decimal(10, 3)
  reason           String?
  approvedByUserId String?
  approvedByName   String?
  createdAt        DateTime     @default(now())
}

model RolePermission {
  id        String   @id @default(uuid())
  role      Role     @unique
  modules   String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ItemVariant {
  id          String   @id @default(uuid())
  itemId      String
  sku         String   @unique
  barcode     String   @unique
  variantName String
  price       Decimal  @db.Decimal(10, 3)
  cost        Decimal  @default(0) @db.Decimal(10, 3)
  stock       Decimal  @default(0) @db.Decimal(10, 3)
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ItemSerial {
  id           String       @id @default(uuid())
  itemId       String
  serialNumber String       @unique
  status       SerialStatus @default(IN_STOCK)
  item         Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model ItemBatch {
  id          String   @id @default(uuid())
  itemId      String
  batchNumber String
  expiryDate  DateTime
  quantity    Decimal  @db.Decimal(10, 3)
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([itemId, batchNumber])
}

// ================= INVENTORY MOVEMENTS & STOCK OPERATIONS =================

model InventoryMovement {
  id            String       @id @default(uuid())
  itemId        String
  branchId      String
  movementType  MovementType
  quantity      Decimal      @db.Decimal(10, 3)
  unitCost      Decimal      @db.Decimal(10, 3)
  totalCost     Decimal      @db.Decimal(10, 3)
  referenceType String?      // "SalesInvoice", "PurchaseInvoice", "StockTransfer", "StockAdjustment"
  referenceId   String?
  notes         String?
  createdAt     DateTime     @default(now())
}

model StockAdjustment {
  id               String           @id @default(uuid())
  adjustmentNumber String           @unique // e.g. "ADJ-0001"
  branchId         String
  branch           Branch           @relation(fields: [branchId], references: [id])
  reason           AdjustmentReason @default(COUNT_CORRECTION)
  status           AdjustmentStatus @default(POSTED)
  totalValue       Decimal          @default(0) @db.Decimal(10, 3)
  notes            String?

  journalEntry     JournalEntry?
  lines            StockAdjustmentLine[]

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model StockAdjustmentLine {
  id                String          @id @default(uuid())
  stockAdjustmentId String
  itemId            String
  quantityChange    Decimal         @db.Decimal(10, 3) // +10 or -5
  unitCost          Decimal         @db.Decimal(10, 3)
  totalCost         Decimal         @db.Decimal(10, 3)

  stockAdjustment   StockAdjustment @relation(fields: [stockAdjustmentId], references: [id], onDelete: Cascade)
  item              Item            @relation(fields: [itemId], references: [id])
}

model StockCount {
  id          String           @id @default(uuid())
  countNumber String           @unique // e.g. "SC-0001"
  branchId    String
  branch      Branch           @relation(fields: [branchId], references: [id])
  status      StockCountStatus @default(IN_PROGRESS)
  countedAt   DateTime         @default(now())
  notes       String?

  lines       StockCountLine[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model StockCountLine {
  id              String     @id @default(uuid())
  stockCountId    String
  itemId          String
  systemQuantity  Decimal    @db.Decimal(10, 3)
  countedQuantity Decimal    @db.Decimal(10, 3)
  variance        Decimal    @db.Decimal(10, 3)
  unitCost        Decimal    @default(0) @db.Decimal(10, 3)

  stockCount      StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  item            Item       @relation(fields: [itemId], references: [id])
}

// ================= CASH & BANK MANAGEMENT =================

model CashAccount {
  id            String         @id @default(uuid())
  code          String         @unique // e.g. "CASH-HQ", "CASH-BR01"
  name          String
  branchId      String?
  branch        Branch?        @relation(fields: [branchId], references: [id])
  balance       Decimal        @default(0) @db.Decimal(10, 3)
  isMain        Boolean        @default(false)
  isActive      Boolean        @default(true)

  transfersFrom CashTransfer[] @relation("FromCashAccount")
  transfersTo   CashTransfer[] @relation("ToCashAccount")

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model CashTransfer {
  id                String       @id @default(uuid())
  transferNumber    String       @unique // e.g. "CTX-0001"
  fromCashAccountId String
  toCashAccountId   String
  amount            Decimal      @db.Decimal(10, 3)
  status            String       @default("COMPLETED")
  notes             String?

  fromCashAccount   CashAccount  @relation("FromCashAccount", fields: [fromCashAccountId], references: [id])
  toCashAccount     CashAccount  @relation("ToCashAccount", fields: [toCashAccountId], references: [id])

  journalEntry      JournalEntry?

  createdAt         DateTime     @default(now())
}

model BankAccount {
  id            String              @id @default(uuid())
  code          String              @unique // e.g. "NBK-001"
  name          String
  bankName      String
  accountNumber String
  iban          String?
  balance       Decimal             @default(0) @db.Decimal(10, 3)
  currency      String              @default("KWD")
  isActive      Boolean             @default(true)

  transactions    BankTransaction[]
  reconciliations BankReconciliation[]

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model BankTransaction {
  id            String      @id @default(uuid())
  bankAccountId String
  type          BankTxType
  amount        Decimal     @db.Decimal(10, 3)
  reference     String?
  transactionDate DateTime  @default(now())
  isReconciled  Boolean     @default(false)
  notes         String?

  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])
  reconItems    BankReconciliationItem[]

  createdAt     DateTime    @default(now())
}

model BankReconciliation {
  id                     String      @id @default(uuid())
  bankAccountId          String
  statementDate          DateTime
  statementEndingBalance Decimal     @db.Decimal(10, 3)
  bookBalance            Decimal     @db.Decimal(10, 3)
  difference             Decimal     @default(0) @db.Decimal(10, 3)
  status                 ReconStatus @default(DRAFT)
  notes                  String?

  bankAccount            BankAccount @relation(fields: [bankAccountId], references: [id])
  items                  BankReconciliationItem[]

  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
}

model BankReconciliationItem {
  id               String             @id @default(uuid())
  reconciliationId String
  transactionId    String
  matched          Boolean            @default(true)
  notes            String?

  reconciliation   BankReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  transaction      BankTransaction    @relation(fields: [transactionId], references: [id])
}

// ================= COST CENTERS & EXPENSES =================

model CostCenter {
  id                 String         @id @default(uuid())
  code               String         @unique // e.g. "CC-SALES-BR01"
  name               String
  type               CostCenterType @default(BRANCH)
  parentCostCenterId String?
  isActive           Boolean        @default(true)

  expenses           Expense[]

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model ExpenseCategory {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  accountId String?
  isActive  Boolean   @default(true)

  expenses  Expense[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Expense {
  id             String          @id @default(uuid())
  expenseNumber  String          @unique // e.g. "EXP-0001"
  date           DateTime        @default(now())
  branchId       String
  branch         Branch          @relation(fields: [branchId], references: [id])
  categoryId     String
  category       ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount         Decimal         @db.Decimal(10, 3)
  paymentMethod  PaymentMethod   @default(CASH)
  costCenterId   String?
  costCenter     CostCenter?     @relation(fields: [costCenterId], references: [id])
  status         String          @default("POSTED")
  notes          String?

  journalEntry   JournalEntry?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// ================= LOYALTY & REWARDS =================

model LoyaltyProgram {
  id                String   @id @default(uuid())
  name              String   @default("Standard Rewards")
  pointsPerKwd      Decimal  @default(10) @db.Decimal(10, 3)
  kwdPerPoint       Decimal  @default(0.010) @db.Decimal(10, 3)
  minPointsToRedeem Int      @default(100)
  isActive          Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model LoyaltyAccount {
  id            String        @id @default(uuid())
  customerId    String        @unique
  pointsBalance Int           @default(0)
  tier          LoyaltyTier   @default(BRONZE)

  transactions  LoyaltyTransaction[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model LoyaltyTransaction {
  id               String         @id @default(uuid())
  loyaltyAccountId String
  salesInvoiceId   String?
  points           Int
  type             LoyaltyTxType  @default(EARN)
  notes            String?

  loyaltyAccount   LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)

  createdAt        DateTime       @default(now())
}

// ================= SALES TARGETS & COMMISSIONS =================

model SalesTarget {
  id             String       @id @default(uuid())
  userId         String
  branchId       String?
  targetPeriod   TargetPeriod @default(MONTHLY)
  startDate      DateTime
  endDate        DateTime
  targetAmount   Decimal      @db.Decimal(10, 3)
  achievedAmount Decimal      @default(0) @db.Decimal(10, 3)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model CommissionRule {
  id                String   @id @default(uuid())
  name              String
  minAmount         Decimal  @default(0) @db.Decimal(10, 3)
  maxAmount         Decimal  @db.Decimal(10, 3)
  commissionPercent Decimal  @db.Decimal(5, 2)
  fixedBonus        Decimal  @default(0) @db.Decimal(10, 3)
  isActive          Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model CommissionCalculation {
  id               String   @id @default(uuid())
  userId           String
  period           String
  totalSales       Decimal  @default(0) @db.Decimal(10, 3)
  returnsDeduction Decimal  @default(0) @db.Decimal(10, 3)
  netSales         Decimal  @default(0) @db.Decimal(10, 3)
  commissionEarned Decimal  @default(0) @db.Decimal(10, 3)
  status           String   @default("APPROVED")

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ================= HR & PAYROLL =================

model Employee {
  id                 String         @id @default(uuid())
  code               String         @unique // e.g. "EMP-001"
  name               String
  civilId            String?        @unique
  position           String
  department         String?
  branchId           String?
  branch             Branch?        @relation(fields: [branchId], references: [id])
  basicSalary        Decimal        @db.Decimal(10, 3)
  housingAllowance   Decimal        @default(0) @db.Decimal(10, 3)
  transportAllowance Decimal        @default(0) @db.Decimal(10, 3)
  otherAllowances    Decimal        @default(0) @db.Decimal(10, 3)
  hireDate           DateTime       @default(now())
  isActive           Boolean        @default(true)

  attendances        Attendance[]
  leaveRequests      LeaveRequest[]
  payrollSlips       PayrollSlip[]

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Attendance {
  id            String   @id @default(uuid())
  employeeId    String
  date          DateTime
  checkIn       String?
  checkOut      String?
  hoursWorked   Decimal  @default(8.0) @db.Decimal(5, 2)
  overtimeHours Decimal  @default(0) @db.Decimal(5, 2)
  status        String   @default("PRESENT")

  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
}

model LeaveRequest {
  id         String      @id @default(uuid())
  employeeId String
  leaveType  LeaveType   @default(ANNUAL)
  startDate  DateTime
  endDate    DateTime
  daysCount  Int
  status     LeaveStatus @default(PENDING)
  notes      String?

  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model PayrollPeriod {
  id              String        @id @default(uuid())
  periodName      String        // e.g. "August 2026 Payroll"
  month           Int
  year            Int
  totalGross      Decimal       @default(0) @db.Decimal(10, 3)
  totalDeductions Decimal       @default(0) @db.Decimal(10, 3)
  totalNet        Decimal       @default(0) @db.Decimal(10, 3)
  status          String        @default("POSTED")

  journalEntry    JournalEntry?
  slips           PayrollSlip[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model PayrollSlip {
  id               String        @id @default(uuid())
  payrollPeriodId  String
  employeeId       String
  basicSalary      Decimal       @db.Decimal(10, 3)
  allowances       Decimal       @default(0) @db.Decimal(10, 3)
  deductions       Decimal       @default(0) @db.Decimal(10, 3)
  overtimeAmount   Decimal       @default(0) @db.Decimal(10, 3)
  commissionAmount Decimal       @default(0) @db.Decimal(10, 3)
  netSalary        Decimal       @db.Decimal(10, 3)
  status           String        @default("PAID")

  payrollPeriod    PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employee         Employee      @relation(fields: [employeeId], references: [id])

  createdAt        DateTime      @default(now())
}

// ================= PURCHASING & SALES LIFECYCLE EXTENSIONS =================

model PurchaseRequisition {
  id                String                    @id @default(uuid())
  prNumber          String                    @unique // e.g. "PR-0001"
  branchId          String
  branch            Branch                    @relation(fields: [branchId], references: [id])
  requestedByUserId String?
  status            PrStatus                  @default(PENDING)
  notes             String?

  lines             PurchaseRequisitionLine[]

  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
}

model PurchaseRequisitionLine {
  id                    String              @id @default(uuid())
  purchaseRequisitionId String
  itemId                String
  quantity              Decimal             @db.Decimal(10, 3)
  notes                 String?

  purchaseRequisition   PurchaseRequisition @relation(fields: [purchaseRequisitionId], references: [id], onDelete: Cascade)
  item                  Item                @relation(fields: [itemId], references: [id])
}

model GoodsReceiptNote {
  id              String             @id @default(uuid())
  grnNumber       String             @unique // e.g. "GRN-0001"
  purchaseOrderId String?
  supplierId      String
  supplier        Supplier           @relation(fields: [supplierId], references: [id])
  branchId        String
  branch          Branch             @relation(fields: [branchId], references: [id])
  status          String             @default("RECEIVED")
  receivedAt      DateTime           @default(now())
  notes           String?

  lines           GoodsReceiptLine[]

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model GoodsReceiptLine {
  id                 String           @id @default(uuid())
  goodsReceiptNoteId String
  itemId             String
  quantityReceived   Decimal          @db.Decimal(10, 3)
  unitCost           Decimal          @db.Decimal(10, 3)
  lineTotal          Decimal          @db.Decimal(10, 3)

  goodsReceiptNote   GoodsReceiptNote @relation(fields: [goodsReceiptNoteId], references: [id], onDelete: Cascade)
  item               Item             @relation(fields: [itemId], references: [id])
}

model Quotation {
  id          String          @id @default(uuid())
  quoteNumber String          @unique // e.g. "QT-0001"
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id])
  branchId    String
  branch      Branch          @relation(fields: [branchId], references: [id])
  validUntil  DateTime?
  subtotal    Decimal         @db.Decimal(10, 3)
  taxAmount   Decimal         @default(0) @db.Decimal(10, 3)
  totalAmount Decimal         @db.Decimal(10, 3)
  status      QuoteStatus     @default(DRAFT)
  notes       String?

  lines       QuotationLine[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model QuotationLine {
  id          String    @id @default(uuid())
  quotationId String
  itemId      String
  quantity    Decimal   @db.Decimal(10, 3)
  unitPrice   Decimal   @db.Decimal(10, 3)
  lineTotal   Decimal   @db.Decimal(10, 3)

  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  item        Item      @relation(fields: [itemId], references: [id])
}

model DeliveryNote {
  id             String             @id @default(uuid())
  deliveryNumber String             @unique // e.g. "DN-0001"
  salesOrderId   String?
  customerId     String
  customer       Customer           @relation(fields: [customerId], references: [id])
  branchId       String
  branch         Branch             @relation(fields: [branchId], references: [id])
  status         String             @default("DELIVERED")
  dispatchedAt   DateTime           @default(now())
  deliveredAt    DateTime?
  notes          String?

  lines          DeliveryNoteLine[]

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model DeliveryNoteLine {
  id             String       @id @default(uuid())
  deliveryNoteId String
  itemId         String
  quantity       Decimal      @db.Decimal(10, 3)
  unitPrice      Decimal      @db.Decimal(10, 3)

  deliveryNote   DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  item           Item         @relation(fields: [itemId], references: [id])
}

model ReceiptVoucher {
  id            String        @id @default(uuid())
  voucherNumber String        @unique // e.g. "RV-0001"
  date          DateTime      @default(now())
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  branchId      String
  branch        Branch        @relation(fields: [branchId], references: [id])
  amount        Decimal       @db.Decimal(10, 3)
  paymentMethod PaymentMethod @default(CASH)
  reference     String?
  notes         String?

  journalEntry  JournalEntry?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model PaymentVoucher {
  id            String        @id @default(uuid())
  voucherNumber String        @unique // e.g. "PV-0001"
  date          DateTime      @default(now())
  supplierId    String
  supplier      Supplier      @relation(fields: [supplierId], references: [id])
  branchId      String
  branch        Branch        @relation(fields: [branchId], references: [id])
  amount        Decimal       @db.Decimal(10, 3)
  paymentMethod PaymentMethod @default(CASH)
  reference     String?
  notes         String?

  journalEntry  JournalEntry?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// ================= PRICING ENGINE RULES =================

model CustomerGroupPrice {
  id            String   @id @default(uuid())
  customerGroup String   // e.g. "WHOLESALE", "VIP"
  itemId        String
  unitPrice     Decimal  @db.Decimal(10, 3)
  minQuantity   Decimal  @default(1) @db.Decimal(10, 3)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([customerGroup, itemId, minQuantity])
}

model ItemPriceTier {
  id          String   @id @default(uuid())
  itemId      String
  tierName    String
  minQuantity Decimal  @db.Decimal(10, 3)
  unitPrice   Decimal  @db.Decimal(10, 3)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([itemId, minQuantity])
}
