// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  moduleFormat = "cjs"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ================= ENUMS (9) =================

// ASSUMED: matches frontend BrandId type — verify against lib/types/index.ts
enum BrandId {
  BIN_ESSA_SMOKING_CENTER
  BIN_ESSA_KHIRAN
  JM_ART_ZONE
}

// ASSUMED: matches frontend Role type — verify values/casing
enum Role {
  ADMIN
  MANAGER
  CASHIER
  ACCOUNTANT
  STOREKEEPER
  SALES_REP
  B2B_CUSTOMER
}

// ASSUMED: matches frontend ItemCategory — verify exact category list
enum ItemCategory {
  TOBACCO
  ACCESSORIES
  ELECTRONICS
  ART_SUPPLIES
  OTHER
}

// ASSUMED: matches frontend ItemVisibility
enum ItemVisibility {
  ALL_BRANCHES
  SPECIFIC_BRANCHES
}

// ASSUMED: matches frontend PaymentMethod
enum PaymentMethod {
  CASH
  CARD
  CREDIT
  BANK_TRANSFER
}

// ASSUMED: matches frontend AccountType (standard chart-of-accounts types)
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

// NOT explicitly in your type list — added because a real SalesInvoice needs a status.
// FLAG: confirm this doesn't already exist under a different name in sales-invoice.ts
enum InvoiceStatus {
  DRAFT
  POSTED
  PAID
  VOID
}

// NOT explicitly in your type list — added so JournalEntry has a lifecycle state.
// FLAG: confirm against lib/types/index.ts JournalEntry definition
enum JournalEntryStatus {
  DRAFT
  POSTED
}

enum PurchaseOrderStatus {
  DRAFT
  POSTED
  CANCELLED
}

// NOT explicitly in your type list — added for ItemStock audit trail readiness.
// FLAG: only needed if you track stock movement history; otherwise can be deleted
enum StockMovementType {
  SALE
  PURCHASE
  ADJUSTMENT
}

enum PromotionDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromotionTargetType {
  PRODUCT
  PRODUCT_GROUP
  CATEGORY
  ALL_PRODUCTS
}

enum PromotionBranchScope {
  ALL_BRANCHES
  SPECIFIC_BRANCHES
}

enum PromotionCustomerScope {
  ALL_CUSTOMERS
  SPECIFIC_CUSTOMER
  CUSTOMER_GROUP
}

enum DiscountType {
  MANUAL_LINE
  MANUAL_HEADER
  PROMOTION
}

// ================= MODELS (11) =================

model Branch {
  id       String  @id @default(uuid())
  code     String  @unique // e.g. "br-01"
  name     String
  brandId  BrandId
  nameEn   String?
  nameAr   String?
  city     String?
  address  String?
  isActive Boolean @default(true)

  users            User[]
  itemStocks       ItemStock[]
  customers        Customer[]
  suppliers        Supplier[]
  salesInvoices    SalesInvoice[]
  journalEntries   JournalEntry[]
  purchaseOrders   PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]
  salesOrders      SalesOrder[]
  posShifts        PosShift[]
  promotionBranches PromotionBranch[]


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String  @id @default(uuid())
  username     String  @unique
  passwordHash String
  fullName     String
  role         Role
  branchId     String?
  branch       Branch? @relation(fields: [branchId], references: [id])
  isActive     Boolean @default(true)

  salesInvoices SalesInvoice[]
  posShifts     PosShift[]
  discountPermission UserDiscountPermission?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Item {
  id         String         @id @default(uuid())
  sku        String         @unique
  barcode    String?        @unique
  name       String
  category   ItemCategory
  visibility ItemVisibility @default(ALL_BRANCHES)
  price      Decimal        @db.Decimal(10, 3) // KWD uses 3 decimal places
  cost       Decimal        @db.Decimal(10, 3)
  unit       String         @default("pcs")
  isActive   Boolean        @default(true)
  stockQuantity Int          @default(0)

  stocks               ItemStock[]
  salesInvoiceLines    SalesInvoiceLine[]
  purchaseOrderLines   PurchaseOrderLine[]
  purchaseInvoiceLines PurchaseInvoiceLine[]
  stockTransferLines   StockTransferLine[]
  salesOrderLines      SalesOrderLine[]
  promotionItems       PromotionItem[]


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ItemStock {
  id       String  @id @default(uuid())
  itemId   String
  branchId String
  quantity Decimal @default(0) @db.Decimal(10, 3)

  item   Item   @relation(fields: [itemId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([itemId, branchId])
}

model Customer {
  id           String   @id @default(uuid())
  code         String   @unique // e.g. "cust-0001"
  name         String
  phone        String?
  email        String?
  address      String?
  branchId     String?
  creditLimit  Decimal  @default(0) @db.Decimal(10, 3)
  paymentTerms String?  @default("NET_30")
  branch       Branch?  @relation(fields: [branchId], references: [id])

  salesInvoices SalesInvoice[]
  salesOrders   SalesOrder[]
  payments      CustomerPayment[]
  pdcChecks     PdcCheck[]
  promotionCustomers PromotionCustomer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Supplier {
  id       String  @id @default(uuid())
  code     String  @unique
  name     String
  phone    String?
  email    String?
  address  String?
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  purchaseOrders   PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id   String      @id @default(uuid())
  code String      @unique // e.g. "1000" for Cash
  name String
  type AccountType

  journalEntryLines JournalEntryLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JournalEntry {
  id          String             @id @default(uuid())
  reference   String             @unique // e.g. "JE-0001"
  date        DateTime           @default(now())
  description String?
  status      JournalEntryStatus @default(POSTED)
  branchId    String?
  branch      Branch?            @relation(fields: [branchId], references: [id])

  // Links back to auto-generated entries
  salesInvoiceId String?       @unique
  salesInvoice   SalesInvoice? @relation(fields: [salesInvoiceId], references: [id])

  purchaseOrderId String?        @unique
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  purchaseInvoiceId String?          @unique
  purchaseInvoice   PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])

  customerPaymentId String?          @unique
  customerPayment   CustomerPayment? @relation(fields: [customerPaymentId], references: [id])


  lines JournalEntryLine[]

  createdAt DateTime @default(now())
}

model JournalEntryLine {
  id             String  @id @default(uuid())
  journalEntryId String
  accountId      String
  debit          Decimal @default(0) @db.Decimal(10, 3)
  credit         Decimal @default(0) @db.Decimal(10, 3)

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])
  account      Account      @relation(fields: [accountId], references: [id])
}

model SalesInvoice {
  id                   String        @id @default(uuid())
  invoiceNumber        String        @unique // e.g. "INV-0001"
  date                 DateTime      @default(now())
  customerId           String?
  customer             Customer?     @relation(fields: [customerId], references: [id])
  branchId             String
  branch               Branch        @relation(fields: [branchId], references: [id])
  userId               String
  user                 User          @relation(fields: [userId], references: [id])
  paymentMethod        PaymentMethod
  status               InvoiceStatus @default(POSTED)
  subtotal             Decimal       @db.Decimal(10, 3)
  taxAmount            Decimal       @default(0) @db.Decimal(10, 3)
  discountAmount       Decimal       @default(0) @db.Decimal(10, 3)
  totalAmount          Decimal       @db.Decimal(10, 3)
  manualDiscountReason String?
  promotionId          String?

  lines        SalesInvoiceLine[]
  journalEntry JournalEntry?

  createdAt DateTime @default(now())
}

model SalesInvoiceLine {
  id                String  @id @default(uuid())
  salesInvoiceId    String
  itemId            String
  quantity          Decimal @db.Decimal(10, 3)
  unitPrice         Decimal @db.Decimal(10, 3)
  originalUnitPrice Decimal? @db.Decimal(10, 3)
  discountAmount    Decimal @default(0) @db.Decimal(10, 3)
  lineTotal         Decimal @db.Decimal(10, 3)
  promotionId       String?

  salesInvoice SalesInvoice @relation(fields: [salesInvoiceId], references: [id])
  item         Item         @relation(fields: [itemId], references: [id])
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  poNumber    String              @unique // e.g. "PO-0001"
  date        DateTime            @default(now())
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  branchId    String
  branch      Branch              @relation(fields: [branchId], references: [id])
  status      PurchaseOrderStatus @default(POSTED)
  subtotal    Decimal             @db.Decimal(10, 3)
  taxAmount   Decimal             @default(0) @db.Decimal(10, 3)
  totalAmount Decimal             @db.Decimal(10, 3)

  lines        PurchaseOrderLine[]
  journalEntry JournalEntry?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseOrderLine {
  id              String        @id @default(uuid())
  purchaseOrderId String
  itemId          String
  quantity        Decimal       @db.Decimal(10, 3)
  unitCost        Decimal       @db.Decimal(10, 3)
  lineTotal       Decimal       @db.Decimal(10, 3)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id])
}

model PurchaseInvoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique // e.g. "PINV-0001" or vendor bill #
  date          DateTime      @default(now())
  dueDate       DateTime?
  paymentTerms  String?       @default("IMMEDIATE") // e.g. NET 30, IMMEDIATE, CREDIT
  supplierId    String
  supplier      Supplier      @relation(fields: [supplierId], references: [id])
  branchId      String
  branch        Branch        @relation(fields: [branchId], references: [id])
  status        InvoiceStatus @default(POSTED)
  subtotal      Decimal       @db.Decimal(10, 3)
  taxAmount     Decimal       @default(0) @db.Decimal(10, 3)
  totalAmount   Decimal       @db.Decimal(10, 3)

  lines        PurchaseInvoiceLine[]
  journalEntry JournalEntry?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseInvoiceLine {
  id                String  @id @default(uuid())
  purchaseInvoiceId String
  itemId            String
  quantity          Decimal @db.Decimal(10, 3)
  unitCost          Decimal @db.Decimal(10, 3)
  lineTotal         Decimal @db.Decimal(10, 3)

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  item            Item            @relation(fields: [itemId], references: [id])
}

// ================= ENTERPRISE COMMERCIAL MODULES =================

enum TransferStatus {
  DRAFT
  DISPATCHED
  RECEIVED
  CANCELLED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model StockTransfer {
  id             String         @id @default(uuid())
  transferNumber String         @unique // e.g. "TR-0001"
  fromBranchId   String
  toBranchId     String
  status         TransferStatus @default(DRAFT)
  notes          String?
  dispatchedAt   DateTime?
  receivedAt     DateTime?

  lines StockTransferLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockTransferLine {
  id                 String  @id @default(uuid())
  stockTransferId    String
  itemId             String
  quantityRequested  Decimal @db.Decimal(10, 3)
  quantityDispatched Decimal @default(0) @db.Decimal(10, 3)
  quantityReceived   Decimal @default(0) @db.Decimal(10, 3)

  stockTransfer StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id])
}

model PosShift {
  id                 String      @id @default(uuid())
  shiftNumber        String      @unique // e.g. "SHIFT-0001"
  userId             String
  branchId           String
  openingFloat       Decimal     @default(0) @db.Decimal(10, 3)
  closingCashExpected Decimal    @default(0) @db.Decimal(10, 3)
  closingCashActual  Decimal     @default(0) @db.Decimal(10, 3)
  cashVariance       Decimal     @default(0) @db.Decimal(10, 3)
  status             ShiftStatus @default(OPEN)
  openedAt           DateTime    @default(now())
  closedAt           DateTime?

  user   User   @relation(fields: [userId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String   // e.g. "STOCK_TRANSFER", "PRICE_OVERRIDE", "INVOICE_VOID"
  entity      String   // e.g. "SalesInvoice", "ItemStock"
  entityId    String?
  details     String?  // JSON formatted details of change
  ipAddress   String?
  createdAt   DateTime @default(now())
}

// ================= MILESTONE 2: B2B COMMERCIAL & ACCOUNTS RECEIVABLE =================

enum OrderStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  CREDIT_HOLD
  INVOICED
  CANCELLED
}

enum PdcStatus {
  RECEIVED
  DEPOSITED
  CLEARED
  BOUNCED
}

model SalesOrder {
  id          String      @id @default(uuid())
  orderNumber String      @unique // e.g. "SO-0001"
  date        DateTime    @default(now())
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  branchId    String
  branch      Branch      @relation(fields: [branchId], references: [id])
  status      OrderStatus @default(DRAFT)
  subtotal    Decimal     @db.Decimal(10, 3)
  taxAmount   Decimal     @default(0) @db.Decimal(10, 3)
  totalAmount Decimal     @db.Decimal(10, 3)
  notes       String?

  lines SalesOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SalesOrderLine {
  id           String     @id @default(uuid())
  salesOrderId String
  itemId       String
  quantity     Decimal    @db.Decimal(10, 3)
  unitPrice    Decimal    @db.Decimal(10, 3)
  lineTotal    Decimal    @db.Decimal(10, 3)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  item       Item       @relation(fields: [itemId], references: [id])
}

model CustomerPayment {
  id            String        @id @default(uuid())
  receiptNumber String        @unique // e.g. "RCT-0001"
  date          DateTime      @default(now())
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  amount        Decimal       @db.Decimal(10, 3)
  paymentMethod PaymentMethod
  reference     String?       // Check # or Transfer Ref
  notes         String?

  journalEntry JournalEntry?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model PdcCheck {
  id          String    @id @default(uuid())
  checkNumber String    @unique
  bankName    String
  dueDate     DateTime
  amount      Decimal   @db.Decimal(10, 3)
  status      PdcStatus @default(RECEIVED)
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ================= PROMOTION & DISCOUNT ENGINE =================

model UserDiscountPermission {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  maxDiscountPercent      Decimal  @default(10.000) @db.Decimal(10, 3)
  canEditPrices           Boolean  @default(false)
  requiresManagerApproval Boolean  @default(true)
  allowedBranchIds        String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Promotion {
  id            String                 @id @default(uuid())
  code          String                 @unique
  nameEn        String
  nameAr        String?
  description   String?
  discountType  PromotionDiscountType
  discountValue Decimal                @db.Decimal(10, 3)
  startDate     DateTime
  endDate       DateTime
  startTime     String?                // e.g. "09:00"
  endTime       String?                // e.g. "21:00"
  maxQuantity   Int?                   // max eligible qty per transaction
  isCombinable  Boolean                @default(false)
  isActive      Boolean                @default(true)
  targetType    PromotionTargetType    @default(ALL_PRODUCTS)
  branchScope   PromotionBranchScope   @default(ALL_BRANCHES)
  customerScope PromotionCustomerScope @default(ALL_CUSTOMERS)
  customerGroup String?                // e.g. "VIP", "WHOLESALE"

  items     PromotionItem[]
  branches  PromotionBranch[]
  customers PromotionCustomer[]
  auditLogs DiscountAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromotionItem {
  id          String    @id @default(uuid())
  promotionId String
  itemId      String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([promotionId, itemId])
}

model PromotionBranch {
  id          String    @id @default(uuid())
  promotionId String
  branchId    String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([promotionId, branchId])
}

model PromotionCustomer {
  id          String    @id @default(uuid())
  promotionId String
  customerId  String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([promotionId, customerId])
}

model DiscountAuditLog {
  id               String       @id @default(uuid())
  userId           String
  userName         String
  userRole         String
  branchId         String
  invoiceNumber    String
  discountType     DiscountType
  promotionId      String?
  promotion        Promotion?   @relation(fields: [promotionId], references: [id])
  originalAmount   Decimal      @db.Decimal(10, 3)
  discountAmount   Decimal      @db.Decimal(10, 3)
  finalAmount      Decimal      @db.Decimal(10, 3)
  reason           String?
  approvedByUserId String?
  approvedByName   String?
  createdAt        DateTime     @default(now())
}


