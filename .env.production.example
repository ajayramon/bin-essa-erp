# Public DNS name pointing to the VPS. Caddy obtains and renews TLS automatically.
APP_DOMAIN=erp.example.com

# Neon pooled runtime URL and direct migration URL. Both must include sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST/DB_NAME?sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DB_NAME?sslmode=require

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret