# ==============================================================================
# BIN ESSA ERP — PRODUCTION DOCKER COMPOSE ENVIRONMENT TEMPLATE
# ==============================================================================

# 1. PostgreSQL 16 Enterprise Database
POSTGRES_USER=bin_essa_admin
POSTGRES_PASSWORD=ChangeThisToStrongPassword2026!
POSTGRES_DB=bin_essa_erp_db
POSTGRES_PORT=5432

# 2. PgBouncer Connection Pooler
PGBOUNCER_PORT=6432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=50

# 3. Redis 7 Cache
REDIS_PORT=6379

# 4. NestJS Backend API
BACKEND_PORT=4000
NODE_ENV=production
JWT_SECRET=ChangeThisToStrong64CharRandomHexKeyForProductionAuth
DATABASE_URL=postgresql://bin_essa_admin:ChangeThisToStrongPassword2026!@pgbouncer:6432/bin_essa_erp_db?schema=public&pgbouncer=true
DIRECT_DATABASE_URL=postgresql://bin_essa_admin:ChangeThisToStrongPassword2026!@postgres:5432/bin_essa_erp_db?schema=public

# 5. Next.js 16 Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=/api

# 6. Nginx Reverse Proxy
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
